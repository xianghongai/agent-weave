    "-y",
    "@upstash/context7-mcp@latest"
  ],
  "env": {
    "CONTEXT7_API_KEY": "\${CONTEXT7_API_KEY}"
  }
},
"filesystem": {
  "type": "stdio",
  "command": "npx",
  "args": [
    "-y",
    "@modelcontextprotocol/server-filesystem",
    "/home/alice"
  ]
},
"firefox-devtools": {
  "type": "stdio",
  "command": "npx",
