    "-y",
    "chrome-devtools-mcp@latest",
    "--auto-connect",
    "--category-extensions",
    "--no-usage-statistics",
    "--no-performance-crux"
  ]
},
"context7": {
  "type": "stdio",
  "command": "npx",
