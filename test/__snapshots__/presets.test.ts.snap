exports[`预设：各 Agent 的生成快照 > CodeBuddy Code 1`] = `
{
  "mcp": {
    "copyInnerText": ""chrome-devtools": {
  "type": "stdio",
  "command": "npx",
  "args": [
    "-y",
    "chrome-devtools-mcp@latest",
    "--auto-connect",
    "--category-extensions",
    "--no-usage-statistics",
    "--no-performance-crux"
  ]
},
"context7": {
  "type": "stdio",
  "command": "npx",
  "args": [
    "-y",
    "@upstash/context7-mcp@latest"
  ],
  "env": {
    "CONTEXT7_API_KEY": "\${CONTEXT7_API_KEY}"
  }
},
"filesystem": {
  "type": "stdio",
  "command": "npx",
  "args": [
    "-y",
    "@modelcontextprotocol/server-filesystem",
    "/home/alice"
  ]
},
"firefox-devtools": {
  "type": "stdio",
  "command": "npx",
  "args": [
    "-y",
    "@mozilla/firefox-devtools-mcp@latest",
    "--connect-existing",
    "--tool-preset",
    "developer"
  ]
},
"github": {
  "type": "stdio",
  "command": "npx",
  "args": [
    "-y",
    "@modelcontextprotocol/server-github"
  ]
},
"memory": {
  "type": "stdio",
  "command": "npx",
  "args": [
    "-y",
    "@modelcontextprotocol/server-memory"
  ],
  "env": {
    "MEMORY_FILE_PATH": "~/.local/agent/share/mcp-memory.json"
  }
},
"playwright": {
  "type": "stdio",
