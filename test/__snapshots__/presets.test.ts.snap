exports[`预设：各 Agent 的生成快照 > Codex CLI 1`] = `
{
  "mcp": {
    "copyInnerText": null,
    "copyText": "[mcp_servers.chrome-devtools]
type = "stdio"
command = "npx"
args = ["-y", "chrome-devtools-mcp@latest", "--auto-connect", "--category-extensions", "--no-usage-statistics", "--no-performance-crux"]

[mcp_servers.context7]
type = "stdio"
command = "npx"
args = ["-y", "@upstash/context7-mcp@latest"]

[mcp_servers.context7.env]
CONTEXT7_API_KEY = "\${CONTEXT7_API_KEY}"

[mcp_servers.filesystem]
type = "stdio"
command = "npx"
args = ["-y", "@modelcontextprotocol/server-filesystem", "/home/alice"]

[mcp_servers.firefox-devtools]
type = "stdio"
command = "npx"
args = ["-y", "@mozilla/firefox-devtools-mcp@latest", "--connect-existing", "--tool-preset", "developer"]

[mcp_servers.github]
type = "stdio"
command = "npx"
args = ["-y", "@modelcontextprotocol/server-github"]

[mcp_servers.memory]
type = "stdio"
command = "npx"
args = ["-y", "@modelcontextprotocol/server-memory"]

[mcp_servers.memory.env]
MEMORY_FILE_PATH = "~/.local/agent/share/mcp-memory.json"

[mcp_servers.playwright]
type = "stdio"
command = "npx"
args = ["-y", "@playwright/mcp@latest"]

[mcp_servers.sequential-thinking]
type = "stdio"
command = "npx"
args = ["-y", "@modelcontextprotocol/server-sequential-thinking"]",
    "preview": "[mcp_servers.chrome-devtools]
type = "stdio"
command = "npx"
args = ["-y", "chrome-devtools-mcp@latest", "--auto-connect", "--category-extensions", "--no-usage-statistics", "--no-performance-crux"]

[mcp_servers.context7]
type = "stdio"
command = "npx"
args = ["-y", "@upstash/context7-mcp@latest"]

[mcp_servers.context7.env]
CONTEXT7_API_KEY = "\${CONTEXT7_API_KEY}"

[mcp_servers.filesystem]
type = "stdio"
command = "npx"
args = ["-y", "@modelcontextprotocol/server-filesystem", "/home/alice"]

[mcp_servers.firefox-devtools]
type = "stdio"
command = "npx"
args = ["-y", "@mozilla/firefox-devtools-mcp@latest", "--connect-existing", "--tool-preset", "developer"]

[mcp_servers.github]
type = "stdio"
command = "npx"
args = ["-y", "@modelcontextprotocol/server-github"]

[mcp_servers.memory]
type = "stdio"
command = "npx"
args = ["-y", "@modelcontextprotocol/server-memory"]

[mcp_servers.memory.env]
MEMORY_FILE_PATH = "~/.local/agent/share/mcp-memory.json"

[mcp_servers.playwright]
type = "stdio"
command = "npx"
args = ["-y", "@playwright/mcp@latest"]

[mcp_servers.sequential-thinking]
type = "stdio"
command = "npx"
args = ["-y", "@modelcontextprotocol/server-sequential-thinking"]",
    "scopes": [
      {
        "name": "用户级",
        "note": "对当前用户的所有项目生效。Codex 不展开 \${VAR}，也不把本机环境变量全部传给 Server：引用环境变量的字段需要改用 env_vars = ["NAME"]。",
        "path": "~/.codex/config.toml",
      },
      {
        "name": "项目级",
        "note": "只在受信任的项目中生效。Codex 不展开 \${VAR}，也不把本机环境变量全部传给 Server：引用环境变量的字段需要改用 env_vars = ["NAME"]。",
        "path": ".codex/config.toml",
      },
    ],
    "style": "toml",
  },
  "notices": [],
  "permission": null,
  "skippedRules": [],
}
`;

