{
  "name": "agent-weave",
  "version": "0.0.0",
  "private": true,
  "description": "在浏览器里维护一份中立规则集，为多个 AI Coding Agent 生成权限与 MCP 配置。",
  "license": "MIT",
  "author": "Nicholas Hsiang",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "vite build",
    "site:build": "vite build",
    "preview": "vite preview",
    "preview:lan": "vite preview --host",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "pwa:icons": "pwa-assets-generator"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "i18next": "^26.4.2",
    "immer": "^11.2.9",
    "jsonc-parser": "^3.3.1",
    "lucide-react": "^1.48.0",
    "markdown-to-jsx": "^9.10.3",
    "motion": "^13.4.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-router": "^8.5.0",
    "sonner": "^2.0.8",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^1.0.4",
    "@vitejs/plugin-react": "^6.1.1",
    "code-inspector-plugin": "^2.0.9",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "shadcn": "^4.21.0",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2",
    "workbox-window": "^7.4.1"
  },
  "simple-git-hooks": {
    "pre-commit": "mise exec -- pnpm format:check && mise exec -- pnpm lint"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0"
}
