{
  "priority": 50,
  "agents": [
    // Qwen Code：源自 Gemini CLI，但权限已改为与 Claude Code 相近的 permissions.allow、ask、deny 三列表。
    // 规则写作 ToolName 或 ToolName(specifier)；工具名可以用规范名（如 web_search），也可以用别名（如 Bash、Read）。
    // 路径锚点：// 绝对路径，~/ 主目录，单个前导 / 表示项目根，./ 或不带前缀表示当前目录。
    // 因此路径规则与 Claude Code 一样写成 ~/ 形式，不能用 {{home}}。
    {
      "id": "preset-agent-qwen-code",
      "name": "Qwen Code",
      "description": "preset-agent-qwen-code.description",
      "built_in_tools": [
        // Read 是元类别，覆盖读取文件、搜索内容、查找文件与列目录；只限读取文件时用 ReadFile。
        // Edit 也是元类别，覆盖 edit、write_file、notebook_edit，因此不单列 Write。
        // 规则不会命中或不需要审批的工具（待办、提问、计划模式、工具搜索等）不收录。
        {
          "id": "preset-built-in-qwen-code-read",
          "key": "Read",
          "description": "preset-built-in-qwen-code-read.description",
          "tag_ids": [],
          "high_risk": false,
          "high_risk_reason": "",
          "writes": false,
          "templates": {
            "with_pattern": "Read({pattern}**)",
            "without_pattern": "Read",
          },
        },
        {
          "id": "preset-built-in-qwen-code-edit",
          "key": "Edit",
          "description": "preset-built-in-qwen-code-edit.description",
          "tag_ids": [],
          "high_risk": false,
          "high_risk_reason": "",
          "writes": true,
          "templates": {
            "with_pattern": "Edit({pattern}**)",
            "without_pattern": "Edit",
          },
        },
        // 模式直接写域名，覆盖该域名及其子域名，不带 domain: 前缀。
        {
          "id": "preset-built-in-qwen-code-webfetch",
          "key": "WebFetch",
          "description": "preset-built-in-qwen-code-webfetch.description",
          "tag_ids": [],
          "high_risk": false,
          "high_risk_reason": "",
          "writes": false,
          "templates": {
            "with_pattern": "WebFetch({pattern})",
            "without_pattern": "WebFetch",
          },
        },
        // web_search 没有 PascalCase 别名，用规范名；它不接受模式，有模式的规则会进入跳过的规则。
        // 默认审批模式下第一次搜索会询问，因此值得单独放行或拒绝。
        {
          "id": "preset-built-in-qwen-code-websearch",
          "key": "web_search",
          "description": "preset-built-in-qwen-code-websearch.description",
          "tag_ids": [],
          "high_risk": false,
          "high_risk_reason": "",
          "writes": false,
          "templates": {
            "with_pattern": "",
            "without_pattern": "web_search",
          },
        },
      ],
      // 没有项目本地级的设置文件；项目级设置只在受信任的文件夹中生效。
      "permission_output": {
        "property_path": "permissions",
        "scopes": [
          {
            "name": "preset-agent-qwen-code.permission-scope-user.name",
            "path": "~/.qwen/settings.json",
            "note": "preset-agent-qwen-code.permission-scope-user.note",
          },
          {
            "name": "preset-agent-qwen-code.permission-scope-project.name",
            "path": ".qwen/settings.json",
            "note": "preset-agent-qwen-code.permission-scope-project.note",
          },
        ],
        "decision_keys": {
          "allow": "allow",
          "ask": "ask",
          "deny": "deny",
        },
        // Bash(git *) 按词边界匹配，不匹配 gitk。
        "command_templates": {
          "with_pattern": "Bash({command} {pattern} *)",
          "without_pattern": "Bash({command} *)",
        },
        "mcp_templates": {
          "with_pattern": "mcp__{server}__{pattern}",
          "without_pattern": "mcp__{server}",
        },
      },
      // MCP 与权限写在同一个 settings.json 中，根键 mcpServers。
      // 远程 Server 的 url 表示 SSE、httpUrl 表示 Streamable HTTP；预设的 Server 都是 stdio，不受影响。
      "mcp_output": {
        "style": "json",
        "property_path": "mcpServers",
        "scopes": [
          {
            "name": "preset-agent-qwen-code.mcp-scope-user.name",
            "path": "~/.qwen/settings.json",
            "note": "preset-agent-qwen-code.mcp-scope-user.note",
          },
          {
            "name": "preset-agent-qwen-code.mcp-scope-project.name",
            "path": ".qwen/settings.json",
            "note": "preset-agent-qwen-code.mcp-scope-project.note",
          },
        ],
      },
    },
  ],
}
