{
  "priority": 50,
  "agents": [
    // Cursor CLI：权限写在 permissions 下，只有 allow 与 deny，拒绝优先；询问这一档的决策键留空，询问规则列为跳过的规则。
    // 只覆盖 CLI 的 cli-config.json 与 .cursor/cli.json；IDE 的 permissions.json 是另一套键（terminalAllowlist、mcpAllowlist），两边不互通。
    // Shell(commandBase) 只匹配命令的第一个词。官方另有 command:args 写法（如 Shell(curl:*)），
    // 但只给了 * 这一个例子，参数 glob 如何匹配空格、能否表达 git push --force 这样的子命令前缀都没有说明。
    // 拒绝规则匹配不上会静默放行，因此带模式的命令模板留空，这类规则列为跳过的规则，而不是输出一个不确定的写法。
    {
      "id": "preset-agent-cursor-cli",
      "name": "Cursor CLI",
      "description": "preset-agent-cursor-cli.description",
      "built_in_tools": [
        // CLI 的权限写法只有 Shell、Read、Write、WebFetch、Mcp 五类；Grep、Task、WebSearch 没有独立写法，不收录。
        // 路径模式是以 / 结尾的目录前缀，模板补上 **。相对路径只限当前工作区，绝对路径可以访问工作区之外。
        {
          "id": "preset-built-in-cursor-cli-read",
          "key": "Read",
          "description": "preset-built-in-cursor-cli-read.description",
          "tag_ids": [],
          "high_risk": false,
          "high_risk_reason": "",
          "writes": false,
          "templates": {
            "with_pattern": "Read({pattern}**)",
            "without_pattern": "Read(**)",
          },
        },
        // Cursor 没有独立的 Edit 工具，编辑文件也走 Write。
        {
          "id": "preset-built-in-cursor-cli-write",
          "key": "Write",
          "description": "preset-built-in-cursor-cli-write.description",
          "tag_ids": [],
          "high_risk": false,
          "high_risk_reason": "",
          "writes": true,
          "templates": {
            "with_pattern": "Write({pattern}**)",
            "without_pattern": "Write(**)",
          },
        },
        {
          "id": "preset-built-in-cursor-cli-webfetch",
          "key": "WebFetch",
          "description": "preset-built-in-cursor-cli-webfetch.description",
          "tag_ids": [],
          "high_risk": false,
          "high_risk_reason": "",
          "writes": false,
          "templates": {
            "with_pattern": "WebFetch({pattern})",
            "without_pattern": "WebFetch(*)",
          },
        },
      ],
      "permission_output": {
        "property_path": "permissions",
        "scopes": [
          {
            "name": "preset-agent-cursor-cli.permission-scope-user.name",
            "path": "~/.cursor/cli-config.json",
            "note": "preset-agent-cursor-cli.permission-scope-user.note",
          },
          {
            "name": "preset-agent-cursor-cli.permission-scope-project.name",
            "path": ".cursor/cli.json",
            "note": "preset-agent-cursor-cli.permission-scope-project.note",
          },
        ],
        "decision_keys": {
          "allow": "allow",
          "ask": "",
          "deny": "deny",
        },
        "command_templates": {
          "with_pattern": "",
          "without_pattern": "Shell({command})",
        },
        "mcp_templates": {
          "with_pattern": "Mcp({server}:{pattern})",
          "without_pattern": "Mcp({server}:*)",
        },
      },
      // MCP 与 IDE 共用 mcp.json，Claude 风格 JSON，根键 mcpServers。
      "mcp_output": {
        "style": "json",
        "property_path": "mcpServers",
        "scopes": [
          {
            "name": "preset-agent-cursor-cli.mcp-scope-user.name",
            "path": "~/.cursor/mcp.json",
            "note": "preset-agent-cursor-cli.mcp-scope-user.note",
          },
          {
            "name": "preset-agent-cursor-cli.mcp-scope-project.name",
            "path": ".cursor/mcp.json",
            "note": "preset-agent-cursor-cli.mcp-scope-project.note",
          },
        ],
      },
    },
  ],
  "rules": [
    // 与 Claude Code 一致：网页抓取整体允许。
    {
      "id": "preset-rule-cursor-cli-webfetch-allow",
      "tool": {
        "type": "built_in",
        "id": "preset-built-in-cursor-cli-webfetch",
      },
      "pattern": "",
      "decision": "allow",
      "description": "",
      "high_risk": false,
      "high_risk_reason": "",
    },
  ],
}
